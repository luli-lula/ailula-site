---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import Valley from '../components/Valley.astro';
import { timeline } from '../data/timeline';
import { profile } from '../data/profile';
import { localizedPath, t, type Lang } from '../lib/i18n';
import { byDateDesc, localized } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const projects = (await localized('projects', lang)).sort(byDateDesc);
const posts = (await localized('posts', lang)).sort(byDateDesc).slice(0, 5);
const fmt = (d?: Date) => (d ? d.toISOString().slice(0, 10) : '');
---
<Base>
  <section class="hero">
    <h1>lula</h1>
    <p class="slogan">{t(lang, 'slogan')}</p>
    <p>{t(lang, 'intro')}</p>
  </section>

  <section>
    <h2>{t(lang, 'sectionNow')}</h2>
    <Placeholder note={lang === 'zh' ? '此刻卡片：正在做什么、在找什么' : '"Right now": what I am doing and looking for'} />
  </section>

  <section>
    <h2>{t(lang, 'sectionTimeline')}</h2>
    <ul class="list">
      {timeline.map((m) => (
        <li>
          <time>{m.years}</time>
          <span><strong>{m.title[lang]}</strong><br /><span class="muted">{m.detail[lang]}</span></span>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>{t(lang, 'sectionProjects')}</h2>
    <ul class="list">
      {projects.map(({ slug, entry, fallback }) => (
        <li>
          <a href={localizedPath(`/projects/${slug}/`, lang)}>{entry.data.title}</a>
          <span class="muted">{entry.data.summary}</span>
          {fallback && <span class="lang-label">{t(lang, lang === 'en' ? 'chineseOnly' : 'englishOnly')}</span>}
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>{t(lang, 'sectionWriting')}</h2>
    <ul class="list">
      {posts.map(({ slug, entry }) => (
        <li><time>{fmt(entry.data.date)}</time><a href={localizedPath(`/writing/${slug}/`, lang)}>{entry.data.title}</a></li>
      ))}
    </ul>
    <p><a href={localizedPath('/writing/', lang)}>{t(lang, 'allPosts')} →</a></p>
  </section>

  <section>
    <h2>{t(lang, 'sectionContact')}</h2>
    <p>
      {t(lang, 'email')}: {profile.email ? <a href={`mailto:${profile.email}`}>{profile.email}</a> : <Placeholder note={lang === 'zh' ? '联系邮箱' : 'contact email'} />}
      <br />{t(lang, 'resume')}: {profile.resumePdf ? <a href={profile.resumePdf}>PDF</a> : <Placeholder note={lang === 'zh' ? '简历 PDF' : 'résumé PDF'} />}
      <br /><a href={profile.github}>GitHub</a> · <a href={profile.x}>X</a>
    </p>
  </section>

  <!-- Hi-Fi home: rendered last so the Lo-Fi content above stays first in the document. -->
  <Valley slot="overlay" lang={lang} />
</Base>

<style>
  .hero { padding: 24px 0 8px; }
  .hero h1 { font-size: clamp(44px, 10vw, 72px); margin: 0; }
  .slogan { font-size: 20px; margin: 4px 0 12px; color: var(--accent); }
  .muted { color: var(--muted); font-size: 14px; }
</style>
