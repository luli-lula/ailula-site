---
// Milestone 1 realism test: the photographic redwood climb. Throwaway until lula approves.
import RingCompass from '../../components/RingCompass.astro';
import type { BranchSpec } from '../../scenes/climb/createClimbScene';

type Card = BranchSpec & { title: string; body: string };
// Only facts lula has published; everything else is marked 待补充.
const cards: Card[] = [
  { id: 'pm', year: 2018.3, side: 'left', kind: 'experience', title: '2018–2023 · 大厂产品经理', body: '策略产品方向，6 年换过 4 个团队。细节待补充 / TODO' },
  { id: 'leave', year: 2024.1, side: 'right', kind: 'experience', title: '2024 · 离开大厂', body: '开始自学 Next.js，自己动手做产品。' },
  { id: 'adhd', year: 2025.2, side: 'left', kind: 'project', title: 'ADHDFocus', body: '极简专注计时器。介绍待补充 / TODO' },
  { id: 'celpip', year: 2025.6, side: 'right', kind: 'project', title: 'CELPIP12', body: 'AI 英语写作练习平台。数据待补充 / TODO' },
  { id: 'mg', year: 2025.75, side: 'left', kind: 'experience', title: '2025 · Cornell Master Gardener', body: '搬到纽约州乡下，开始学习照顾一片森林。' },
];
const specs: BranchSpec[] = cards.map(({ id, year, side, kind }) => ({ id, year, side, kind }));
---
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Climb · realism test</title>
  </head>
  <body>
    <canvas id="scene"></canvas>
    <div class="scroll-space"></div>

    <header class="landing" data-fade="landing">
      <h1>lula</h1>
      <p class="slogan">耐心地，长成一棵大树。<br /><span>Growing slowly, like a redwood.</span></p>
      <p class="hint">往下滑，开始往上爬 ↓</p>
    </header>

    <div class="meter" aria-hidden="true">
      <div class="meter-line"><div class="meter-dot"></div></div>
      <span class="meter-text" data-testid="altitude">0m · 2017</span>
    </div>

    {cards.map((c) => (
      <article class={`card card-${c.kind}`} data-card={c.id}>
        <p class="kind">{c.kind === 'project' ? '项目' : c.kind === 'post' ? '文章' : '经历'}</p>
        <h2>{c.title}</h2>
        <p>{c.body}</p>
      </article>
    ))}

    <section class="now" data-fade="now">
      <p class="kind">此刻</p>
      <h2>你爬到顶了 🌲</h2>
      <p>此刻卡片和联系方式：待补充 / TODO</p>
    </section>

    <div class="loading" data-testid="loading">正在走进森林…</div>
    <RingCompass />

    <script define:vars={{ specs }}>
      window.__climbSpecs = specs;
    </script>
    <script>
      import Lenis from 'lenis';
      import { createClimbScene, type BranchSpec } from '../../scenes/climb/createClimbScene';
      import { heightToYear, yearToHeight } from '../../lib/timeline';

      const specs = (window as any).__climbSpecs as BranchSpec[];
      const canvas = document.getElementById('scene') as HTMLCanvasElement;
      const mobile = matchMedia('(max-width: 700px)').matches;
      const scene = createClimbScene(canvas, specs, mobile ? 'low' : 'high');
      scene.ready.then(() => document.querySelector('.loading')?.remove());

      const lenis = new Lenis({ lerp: 0.08 });
      let height = 0;
      lenis.on('scroll', ({ progress }: { progress: number }) => {
        height = progress * 115;
        scene.setHeight(height);
      });
      addEventListener('resize', () => scene.resize());

      const meterText = document.querySelector('.meter-text')!;
      const dot = document.querySelector<HTMLElement>('.meter-dot')!;
      const label = document.querySelector('.ring-label')!;
      const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
      const landing = document.querySelector<HTMLElement>('[data-fade="landing"]')!;
      const now = document.querySelector<HTMLElement>('[data-fade="now"]')!;
      const rings = [...document.querySelectorAll<SVGPathElement>('[data-ring]')];
      const marks = [...document.querySelectorAll<SVGPathElement>('[data-mark]')];

      document.querySelector('.ring-compass')!.addEventListener('click', (e) => {
        const mark = (e.target as Element).closest('[data-mark]');
        if (!mark) return;
        const year = Number(mark.getAttribute('data-mark'));
        lenis.scrollTo((yearToHeight(year) / 115) * lenis.limit);
      });

      const frame = (t: number) => {
        lenis.raf(t);
        const year = Math.min(2026, Math.floor(heightToYear(height)));
        meterText.textContent = `${Math.round(height)}m · ${height >= 112 ? 'now' : year}`;
        dot.style.top = `${100 - (height / 115) * 100}%`;
        label.textContent = String(year);
        rings.forEach((r) => r.classList.toggle('reached', Number(r.dataset.ring) <= year));
        marks.forEach((m) => m.classList.toggle('current', Number(m.dataset.mark) === year));
        landing.style.opacity = String(Math.max(0, 1 - height / 4));
        now.style.opacity = String(Math.max(0, Math.min(1, (height - 110) / 4)));
        now.style.pointerEvents = height > 110 ? 'auto' : 'none';
        for (const el of cards) {
          const a = scene.anchor(el.dataset.card!);
          const spec = specs.find((s) => s.id === el.dataset.card)!;
          const near = Math.abs(yearToHeight(spec.year) - height) < 7 && height < 108;
          el.style.opacity = a.visible && near ? '1' : '0';
          const dx = spec.side === 'right' ? 16 : -16 - el.offsetWidth;
          el.style.transform = `translate(${a.x + dx}px, ${a.y - el.offsetHeight / 2}px)`;
        }
        (window as any).__climb = { height, fps: scene.fps() };
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    </script>

    <style is:global>
      @import 'lenis/dist/lenis.css';
      html, body { margin: 0; background: #aeb9ae; color: #1d2a20; font-family: -apple-system, 'PingFang SC', 'Noto Sans SC', system-ui, sans-serif; }
      #scene { position: fixed; inset: 0; width: 100vw; height: 100vh; display: block; }
      .scroll-space { height: 1400vh; }
      .landing { position: fixed; top: 12vh; left: 0; right: 0; text-align: center; pointer-events: none; color: #1d2a20; }
      .landing h1 { font: 800 clamp(48px, 9vw, 96px)/1 Georgia, 'Songti SC', serif; margin: 0 0 16px; letter-spacing: 0.02em; color: #f7f3ec; text-shadow: 0 2px 30px rgba(0,0,0,.35); }
      .slogan { font-size: 18px; color: #f7f3ec; text-shadow: 0 1px 12px rgba(0,0,0,.5); margin: 0; }
      .slogan span { font-size: 14px; opacity: 0.85; font-style: italic; }
      .hint { position: fixed; bottom: 6vh; left: 0; right: 0; font-size: 13px; color: #f7f3ec; text-shadow: 0 1px 8px rgba(0,0,0,.6); }
      .meter { position: fixed; left: 22px; top: 12vh; bottom: 12vh; width: 120px; pointer-events: none; }
      .meter-line { position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: rgba(255,255,255,.55); }
      .meter-dot { position: absolute; left: -4px; width: 9px; height: 9px; border-radius: 50%; background: #c0492c; transform: translateY(-50%); }
      .meter-text { position: absolute; left: 12px; bottom: -22px; font: 600 12px ui-monospace, monospace; color: #fff; text-shadow: 0 1px 4px rgba(0,0,0,.7); white-space: nowrap; }
      .card { position: fixed; left: 0; top: 0; width: min(260px, 70vw); background: rgba(255, 253, 248, 0.94); border-radius: 12px; padding: 14px 16px; box-shadow: 0 10px 30px rgba(20,30,20,.25); opacity: 0; transition: opacity .35s; will-change: transform; }
      .card h2, .now h2 { margin: 2px 0 6px; font-size: 16px; }
      .card p, .now p { margin: 0; font-size: 13px; line-height: 1.5; color: #4a4a44; }
      .card .kind, .now .kind { font-size: 11px; font-weight: 700; letter-spacing: .08em; color: #9a4f2e; }
      .card-project { border-left: 3px solid #c99a3b; }
      .now { position: fixed; left: 50%; top: 14vh; transform: translateX(-50%); width: min(420px, 86vw); background: rgba(255,253,248,.95); border-radius: 14px; padding: 18px 20px; opacity: 0; box-shadow: 0 10px 40px rgba(20,30,20,.25); }
      .loading { position: fixed; inset: 0; display: grid; place-items: center; background: #aeb9ae; color: #fff; font-size: 14px; letter-spacing: .1em; z-index: 10; }
    </style>
  </body>
</html>
