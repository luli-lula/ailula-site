---
// Realism test C: upgraded 3D — EZ-Tree redwoods, soft shadows, AO, depth of field, film grain.
import RingCompass from '../../components/RingCompass.astro';

// Only facts lula has published; everything else is marked 待补充.
const cards = [
  { id: 'pm', year: 2018.3, side: 'left', kind: '经历', title: '2018–2023 · 大厂产品经理', body: '策略产品方向，6 年换过 4 个团队。细节待补充 / TODO' },
  { id: 'leave', year: 2024.1, side: 'right', kind: '经历', title: '2024 · 离开大厂', body: '开始自学 Next.js，自己动手做产品。' },
  { id: 'adhd', year: 2025.1, side: 'left', kind: '项目', title: 'ADHDFocus', body: '极简专注计时器。介绍待补充 / TODO' },
  { id: 'celpip', year: 2025.45, side: 'right', kind: '项目', title: 'CELPIP12', body: 'AI 英语写作练习平台。数据待补充 / TODO' },
  { id: 'mg', year: 2025.7, side: 'left', kind: '经历', title: '2025 · Cornell Master Gardener', body: '搬到纽约州乡下，开始学习照顾一片森林。' },
];
---
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Climb v2 · realism test C</title>
    
  </head>
  <body>
    <canvas id="scene" aria-hidden="true"></canvas>
    <div class="loading" data-testid="loading">正在走进森林…</div>
    <div class="scroll-space"></div>

    <header class="landing" data-fade="landing">
      <h1>lula</h1>
      <p class="slogan">耐心地，长成一棵大树。<br /><span>Growing slowly, like a redwood.</span></p>
      <p class="hint">往下滑，开始往上爬 ↓</p>
    </header>

    <div class="meter" aria-hidden="true">
      <div class="meter-line"><div class="meter-dot"></div></div>
      <span class="meter-text" data-testid="altitude">0m · 2017</span>
    </div>

    {cards.map((c) => (
      <article class={`card card-${c.side}`} data-card={c.id} data-year={c.year}>
        <p class="kind">{c.kind}</p>
        <h2>{c.title}</h2>
        <p>{c.body}</p>
      </article>
    ))}

    <section class="now" data-fade="now">
      <p class="kind">此刻</p>
      <h2>你爬到顶了 🌲</h2>
      <p>此刻卡片和联系方式：待补充 / TODO</p>
    </section>

    <RingCompass />

    <script>
      import Lenis from 'lenis';
      import { createClimb2 } from '../../scenes/climb2/createClimb2';
      import { heightToYear, yearToHeight } from '../../lib/timeline';

      const canvas = document.getElementById('scene') as HTMLCanvasElement;
      const scene = createClimb2(canvas, matchMedia('(max-width: 700px)').matches ? 'low' : 'high');
      scene.ready.then(() => document.querySelector('.loading')?.remove());
      addEventListener('resize', () => scene.resize());

      const lenis = new Lenis({ lerp: 0.07 });
      let height = 0;
      lenis.on('scroll', ({ progress }: { progress: number }) => {
        height = progress * 115;
        scene.setHeight(height);
      });
      const smooth = (a: number, b: number, x: number) => {
        const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
        return t * t * (3 - 2 * t);
      };

      const meterText = document.querySelector('.meter-text')!;
      const dot = document.querySelector<HTMLElement>('.meter-dot')!;
      const label = document.querySelector('.ring-label')!;
      const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
      const landing = document.querySelector<HTMLElement>('[data-fade="landing"]')!;
      const now = document.querySelector<HTMLElement>('[data-fade="now"]')!;
      const rings = [...document.querySelectorAll<SVGPathElement>('[data-ring]')];
      const marks = [...document.querySelectorAll<SVGPathElement>('[data-mark]')];
      document.querySelector('.ring-compass')!.addEventListener('click', (e) => {
        const mark = (e.target as Element).closest('[data-mark]');
        if (mark) lenis.scrollTo((yearToHeight(Number(mark.getAttribute('data-mark'))) / 115) * lenis.limit);
      });

      const frame = (t: number) => {
        lenis.raf(t);
        const h = height;
        const year = Math.min(2026, Math.floor(heightToYear(h)));
        meterText.textContent = `${Math.round(h)}m · ${h >= 112 ? 'now' : year}`;
        dot.style.top = `${100 - (h / 115) * 100}%`;
        label.textContent = String(year);
        rings.forEach((r) => r.classList.toggle('reached', Number(r.dataset.ring) <= year));
        marks.forEach((m) => m.classList.toggle('current', Number(m.dataset.mark) === year));
        landing.style.opacity = String(Math.max(0, 1 - h / 4));
        now.style.opacity = String(smooth(110, 114, h));
        for (const el of cards) {
          const d = Math.abs(yearToHeight(Number(el.dataset.year)) - h);
          el.style.opacity = String((1 - smooth(3, 6, d)) * (1 - smooth(104, 107, h)));
          el.style.transform = `translateY(${(yearToHeight(Number(el.dataset.year)) - h) * 6}px)`;
        }
        (window as any).__climb = { height: h, fps: scene.fps() };
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    </script>

    <style is:global>
      @import 'lenis/dist/lenis.css';
      html, body { margin: 0; background: #c9cfc4; color: #1d2a20; font-family: -apple-system, 'PingFang SC', 'Noto Sans SC', system-ui, sans-serif; }
      #scene { position: fixed; inset: 0; width: 100vw; height: 100vh; display: block; }
      .loading { position: fixed; inset: 0; display: grid; place-items: center; background: #c9cfc4; color: #fff; font-size: 14px; letter-spacing: .1em; z-index: 10; }
      .scroll-space { height: 1300vh; }
      .landing { position: fixed; top: 12vh; left: 0; right: 0; text-align: center; pointer-events: none; }
      .landing h1 { font: 800 clamp(48px, 9vw, 96px)/1 Georgia, 'Songti SC', serif; margin: 0 0 16px; letter-spacing: 0.02em; color: #f7f3ec; text-shadow: 0 2px 30px rgba(0,0,0,.45); }
      .slogan { font-size: 18px; color: #f7f3ec; text-shadow: 0 1px 12px rgba(0,0,0,.6); margin: 0; }
      .slogan span { font-size: 14px; opacity: 0.9; font-style: italic; }
      .hint { position: fixed; bottom: 6vh; left: 0; right: 0; font-size: 13px; color: #f7f3ec; text-shadow: 0 1px 8px rgba(0,0,0,.7); }
      .meter { position: fixed; left: 22px; top: 12vh; bottom: 12vh; width: 120px; pointer-events: none; }
      .meter-line { position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: rgba(255,255,255,.6); }
      .meter-dot { position: absolute; left: -4px; width: 9px; height: 9px; border-radius: 50%; background: #c0492c; transform: translateY(-50%); }
      .meter-text { position: absolute; left: 12px; bottom: -22px; font: 600 12px ui-monospace, monospace; color: #fff; text-shadow: 0 1px 4px rgba(0,0,0,.8); white-space: nowrap; }
      .card { position: fixed; top: 38vh; width: min(270px, 64vw); background: rgba(255, 253, 248, 0.92); backdrop-filter: blur(6px); border-radius: 12px; padding: 14px 16px; box-shadow: 0 10px 30px rgba(20,30,20,.25); opacity: 0; will-change: transform, opacity; }
      .card-left { left: max(48px, 12vw); }
      .card-right { right: max(48px, 12vw); }
      .card h2, .now h2 { margin: 2px 0 6px; font-size: 16px; }
      .card p, .now p { margin: 0; font-size: 13px; line-height: 1.5; color: #4a4a44; }
      .card .kind, .now .kind { font-size: 11px; font-weight: 700; letter-spacing: .08em; color: #9a4f2e; }
      .now { position: fixed; left: 50%; top: 14vh; transform: translateX(-50%); width: min(420px, 86vw); background: rgba(255,253,248,.95); border-radius: 14px; padding: 18px 20px; opacity: 0; box-shadow: 0 10px 40px rgba(20,30,20,.25); }
      @media (max-width: 700px) { .card-left, .card-right { left: 50%; right: auto; transform: translateX(-50%); } .card { top: auto; bottom: 18vh; } }
    </style>
  </body>
</html>
