---
// Footprint map: a dark world. Countries are outlines; countries lula has been to are divided into
// city-level units, and the units she has been to are lit. Three fixed views (world, China, US) and a few
// numbers. Drawn at build time from src/lib/footprint.ts; the unlit base is a static file per view.
import { litShapes, SIZE, stats, VIEWS, type ViewId } from '../lib/footprint';
import { visits } from '../lib/visits';
import type { Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
const v = visits();
const s = stats(v);
const pct = (a: number, b: number) => `${Math.round((a / b) * 1000) / 10}%`;
const LABEL: Record<ViewId, string> = zh ? { world: '世界', cn: '中国', us: '美国' } : { world: 'World', cn: 'China', us: 'US' };
const views = VIEWS.map((id) => ({ id, w: SIZE[id][0], h: SIZE[id][1], lit: litShapes(id, lang, v) }));
---
<div class="fmap" data-fmap>
  <dl class="fmap-stats">
    <div><dt>{zh ? '国家和地区' : 'Countries'}</dt><dd>{s.countries}<small> / {s.countriesTotal} · {pct(s.countries, s.countriesTotal)}</small></dd></div>
    <div><dt>{zh ? '中国地级市' : 'Chinese cities'}</dt><dd>{s.chn.cities}<small> / {s.chn.citiesTotal} · {pct(s.chn.cities, s.chn.citiesTotal)}</small></dd></div>
    <div><dt>{zh ? '中国省份' : 'Chinese provinces'}</dt><dd>{s.chn.provinces}<small> / {s.chn.provincesTotal}</small></dd></div>
    <div><dt>{zh ? '美国的县' : 'US counties'}</dt><dd>{s.usa.counties}<small> · {s.usa.states} {zh ? '个州' : s.usa.states === 1 ? 'state' : 'states'}</small></dd></div>
  </dl>
  <div class="fmap-views" role="group" aria-label={zh ? '视图' : 'View'}>
    {views.map((v, i) => <button type="button" data-view-pick={v.id} aria-pressed={i === 0 ? 'true' : 'false'}>{LABEL[v.id]}</button>)}
  </div>
  <div class="fmap-scroll">
    {views.map((v, i) => (
      <svg class="fmap-view" data-map-view={v.id} viewBox={`0 0 ${v.w} ${v.h}`} role="img" aria-label={LABEL[v.id]} hidden={i !== 0}>
        <defs>
          <filter id={`glow-${v.id}`} x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="2.4" result="blur" />
            <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
        </defs>
        <image href={`/maps/footprint-${v.id}.svg`} width={v.w} height={v.h} />
        <g filter={`url(#glow-${v.id})`}>
          {v.lit.map((p) => (
            <path class={p.whole ? 'lit whole' : 'lit'} d={p.d} data-place={p.id} data-name={p.name} tabindex="0" role="img" aria-label={p.parent ? `${p.name}, ${p.parent}` : p.name}>
              <title>{p.parent ? `${p.name} · ${p.parent}` : p.name}</title>
            </path>
          ))}
        </g>
      </svg>
    ))}
  </div>
  <p class="fmap-tip" data-map-tip aria-live="polite"></p>
  <p class="fmap-credit">{zh
    ? '边界：Natural Earth（中国视角，公共领域）；中国地级行政区：OCHA / HDX（CC BY-IGO）；美国县界：美国人口普查局（公共领域）'
    : 'Boundaries: Natural Earth (China point of view, public domain); Chinese prefectures: OCHA / HDX (CC BY-IGO); US counties: US Census Bureau (public domain)'}</p>
</div>

<script>
  import { mountMap } from '../scripts/map';
  document.querySelectorAll<HTMLElement>('[data-fmap]').forEach(mountMap);
</script>

<style is:global>
  .fmap { --m-bg: #0b1220; --m-ink: #e8edf5; --m-muted: #9aa8bd; --m-lit: #f4b860; position: relative; color: var(--m-ink); background: var(--m-bg); border-radius: 14px; padding: 16px; }
  .fmap-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin: 0 0 14px; }
  .fmap-stats div { border-left: 2px solid var(--m-lit); padding-left: 10px; }
  .fmap-stats dt { font-size: 12px; color: var(--m-muted); }
  .fmap-stats dd { margin: 2px 0 0; font: 700 24px/1.1 Georgia, 'Songti SC', serif; font-variant-numeric: tabular-nums; }
  .fmap-stats small { font: 400 12px system-ui, sans-serif; color: var(--m-muted); }
  .fmap-views { display: inline-flex; gap: 4px; padding: 3px; border-radius: 999px; background: rgba(255, 255, 255, 0.06); margin-bottom: 10px; }
  .fmap-views button { font: 600 13px system-ui, sans-serif; padding: 6px 14px; border: 0; border-radius: 999px; background: transparent; color: var(--m-muted); cursor: pointer; }
  .fmap-views button[aria-pressed='true'] { background: var(--m-ink); color: var(--m-bg); }
  .fmap-scroll { overflow-x: auto; border-radius: 10px; }
  .fmap-view { display: block; width: 100%; height: auto; background: var(--m-bg); }
  .fmap-view[hidden] { display: none; }
  .fmap image { pointer-events: none; }
  .fmap .lit { fill: var(--m-lit); stroke: #ffe2a8; stroke-width: 0.4; cursor: pointer; outline: none; }
  .fmap .lit.whole { fill-opacity: 0.45; }
  .fmap .lit:hover, .fmap .lit:focus-visible { fill: #ffd894; }
  .fmap-tip { min-height: 1.4em; margin: 8px 0 0; font-size: 14px; color: var(--m-ink); }
  .fmap-credit { font-size: 11px; color: var(--m-muted); margin: 4px 0 0; }
  @media (max-width: 560px) { .fmap-view { min-width: 720px; } }
</style>
