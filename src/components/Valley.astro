---
// Hi-Fi home: the valley diorama with a giant sequoia at its centre. Each place opens a panel built
// from the same content as the Lo-Fi pages. The 3D code loads only in Hi-Fi mode with WebGL.
import Placeholder from './Placeholder.astro';
import Contact from './Contact.astro';
import CloseButton from './CloseButton.astro';
import CinemaWall from './CinemaWall.astro';
import LangBadge from './LangBadge.astro';
import ProjectCard from './ProjectCard.astro';
import { CATEGORY_ORDER } from '../lib/content';
import { TOPICS, topicLabel } from '../lib/topics';
import { timeline } from '../data/timeline';
import { profile } from '../data/profile';
import { community } from '../data/community';
import { localizedPath, t, type Lang } from '../lib/i18n';
import { byDateDesc, localized, projectGroups } from '../lib/content';
import { ZONES } from '../scenes/valley/zones';
import { SEASONS } from '../scenes/valley/palette';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const groups = await projectGroups(lang);
// The workshop shows every project, featured first; the greenhouse keeps only the plant work.
const allProjects = groups.flatMap((g) => g.items).sort((a, b) => Number(b.entry.data.featured) - Number(a.entry.data.featured));
const plantProjects = groups.find((g) => g.category === 'plants')?.items ?? [];
// The garden lists the posts written (or translated) in this language; the English one links to the rest.
const gardenPosts = (await localized('posts', lang)).filter((p) => !p.fallback).sort(byDateDesc);
const gardenTopics = TOPICS.filter((tp) => gardenPosts.some((p) => p.entry.data.topics.includes(tp)));
const label = Object.fromEntries(ZONES.map((z) => [z.id, z.label[lang]]));
---
<div class="valley-root" data-lang={lang}>
  <canvas class="valley-canvas" aria-hidden="true"></canvas>
  <p class="valley-loading">{lang === 'zh' ? '山谷正在醒来…' : 'The valley is waking up…'}</p>
  <div class="valley-labels"></div>

  <header class="valley-bar">
    <div class="valley-brand">
      <span class="name">lula</span>
      <span class="slogan">{t(lang, 'slogan')}</span>
    </div>
    <div class="valley-controls">
      <div class="seasons" role="group" aria-label={t(lang, 'season')}>
        {SEASONS.map((s) => <button type="button" data-season-pick={s} aria-pressed="false">{t(lang, s)}</button>)}
      </div>
      <button type="button" class="pill" data-night-toggle aria-pressed="false" aria-label={t(lang, 'dayNight')}>
        <span class="sun">☀</span><span class="moon">☾</span>
      </button>
      <a class="pill" href={localizedPath('/', other)} hreflang={other}>{t(lang, 'langSwitch')}</a>
      <button type="button" class="pill" data-set-mode="lofi">{t(lang, 'modeLofi')}</button>
    </div>
  </header>

  <p class="valley-hint">{t(lang, 'valleyHint')}</p>

  <section class="vpanel" data-panel="tree" role="dialog" aria-labelledby="vp-tree" hidden>
    <header class="vhead">
      <h2 id="vp-tree" tabindex="-1">{label.tree}</h2>
      <CloseButton lang={lang} />
    </header>
    <div class="vbody" data-filter-scope>
    <p class="intro">{t(lang, 'treeIntro')}</p>
    <ol class="rings">
      {timeline.map((m) => (
        <li><time>{m.years}</time><strong>{m.title[lang]}</strong><p class="detail">{m.detail[lang]}</p></li>
      ))}
    </ol>
    </div>
  </section>

  <!-- The tree hollow opens a full-screen cinema rather than a side panel. -->
  <section class="cinema-overlay" data-panel="hollow" role="dialog" aria-modal="true" aria-labelledby="vp-hollow" hidden>
    <header class="cin-bar">
      <div>
        <h2 id="vp-hollow" tabindex="-1">{label.hollow}</h2>
        <p class="cin-intro">{t(lang, 'hollowIntro')}</p>
      </div>
      <CloseButton lang={lang} />
    </header>
    <CinemaWall lang={lang} embedded />
  </section>

  <section class="vpanel wide" data-panel="workshop" role="dialog" aria-labelledby="vp-workshop" hidden>
    <header class="vhead">
      <h2 id="vp-workshop" tabindex="-1">{label.workshop}</h2>
      <CloseButton lang={lang} />
    </header>
    <div class="vbody" data-filter-scope>
    <p class="intro">{t(lang, 'workshopIntro')}</p>
    <div class="chips" role="group" aria-label={t(lang, 'navProjects')} data-filter>
      <button type="button" data-key="all" aria-pressed="true">{t(lang, 'cat_all')}</button>
      {CATEGORY_ORDER.filter((c) => groups.some((g) => g.category === c)).map((c) => <button type="button" data-key={c} aria-pressed="false">{t(lang, `cat_${c}`)}</button>)}
    </div>
    <div class="pgrid">
      {allProjects.map(({ slug, entry, fallback }) => <ProjectCard lang={lang} slug={slug} entry={entry} fallback={fallback} size={entry.data.featured ? 'large' : 'normal'} />)}
    </div>
    </div>
  </section>

  <section class="vpanel" data-panel="garden" role="dialog" aria-labelledby="vp-garden" hidden>
    <header class="vhead">
      <h2 id="vp-garden" tabindex="-1">{label.garden}</h2>
      <CloseButton lang={lang} />
    </header>
    <div class="vbody" data-filter-scope>
    <p class="intro">{t(lang, 'gardenIntro')}</p>
    <div class="chips" role="group" aria-label={t(lang, 'navWriting')} data-filter>
      <button type="button" data-key="all" aria-pressed="true">{t(lang, 'cat_all')}</button>
      {gardenTopics.map((tp) => <button type="button" data-key={tp} aria-pressed="false">{topicLabel(tp, lang)}</button>)}
    </div>
    <ul class="vlist">
      {gardenPosts.map(({ slug, entry }) => (
        <li data-keys={entry.data.topics.join(' ')}><time>{entry.data.date.toISOString().slice(0, 7)}</time><span class="title"><a href={localizedPath(`/writing/${slug}/`, lang)}>{entry.data.title}</a></span></li>
      ))}
    </ul>
    {lang === 'en' && <p><a href="/writing/#more-in-chinese">{t(lang, 'moreInChinese')} →</a></p>}
    <p><a href={localizedPath('/writing/', lang)}>{t(lang, 'allPosts')} →</a></p>
    </div>
  </section>

  <section class="vpanel" data-panel="greenhouse" role="dialog" aria-labelledby="vp-greenhouse" hidden>
    <header class="vhead">
      <h2 id="vp-greenhouse" tabindex="-1">{label.greenhouse}</h2>
      <CloseButton lang={lang} />
    </header>
    <div class="vbody" data-filter-scope>
    <p class="intro">{t(lang, 'greenhouseIntro')}</p>
    <div class="pstack">
      {plantProjects.map(({ slug, entry, fallback }) => <ProjectCard lang={lang} slug={slug} entry={entry} fallback={fallback} size="compact" />)}
    </div>
    <h3>{t(lang, 'communityTitle')}</h3>
    <ul class="plain">
      {community[lang].map((c) => <li>{c}</li>)}
    </ul>
    <h3>{t(lang, 'photosTitle')}</h3>
    <div class="photos">
      {['1', '2', '3'].map((n) => <img src={`/assets/photos/lula/${n}.webp`} alt={t(lang, 'photosCaption')} loading="lazy" />)}
    </div>
    <p class="muted">{t(lang, 'photosCaption')}</p>
    <Placeholder note={lang === 'zh' ? '更多植物园照片' : 'more botanical garden photos'} />
    </div>
  </section>

  <section class="vpanel" data-panel="lookout" role="dialog" aria-labelledby="vp-lookout" hidden>
    <header class="vhead">
      <h2 id="vp-lookout" tabindex="-1">{label.lookout}</h2>
      <CloseButton lang={lang} />
    </header>
    <div class="vbody" data-filter-scope>
    <p class="intro">{t(lang, 'lookoutIntro')}</p>
    {profile.now[lang] ? (
      <>
        <h3>{t(lang, 'sectionNow')}</h3>
        <p>{profile.now[lang]}</p>
      </>
    ) : <Placeholder note={lang === 'zh' ? '此刻卡片：正在做什么、在找什么' : '"Right now": what I am doing and looking for'} />}
    <h3>{t(lang, 'sectionContact')}</h3>
    <Contact lang={lang} />
    </div>
  </section>

  <section class="vpanel small" data-panel="dog" role="dialog" aria-labelledby="vp-dog" hidden>
    <header class="vhead">
      <h2 id="vp-dog" tabindex="-1">🐕 {label.dog}</h2>
      <CloseButton lang={lang} />
    </header>
    <div class="vbody" data-filter-scope>
    <p>{profile.dogName ? t(lang, 'dogNamed').replace('{name}', profile.dogName) : <>{t(lang, 'dogNote')}<Placeholder note={lang === 'zh' ? '小狗的名字' : "the dog's name"} /></>}</p>
    <div class="dog-photos">
      {['2', '1'].map((n) => <img src={`/assets/photos/doudou/${n}.webp`} alt={`${profile.dogName || label.dog}`} loading="lazy" />)}
    </div>
    </div>
  </section>
</div>

<script>
  import type { Season } from '../scenes/valley/palette';
  import { wireChips } from '../scripts/chips';
  import { mountCinema } from '../scripts/cinema';
  import type { ZoneId } from '../scenes/valley/zones';

  const html = document.documentElement;
  html.classList.add('has-valley');
  const root = document.querySelector<HTMLElement>('.valley-root')!;
  const SEASON_KEY = 'ailula-season';
  const NIGHT_KEY = 'ailula-night';
  const read = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const write = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };

  // Default to the real season and time of day; a visitor's own choice is remembered (also across languages).
  const month = new Date().getMonth();
  const realSeason: Season = month < 2 || month === 11 ? 'winter' : month < 5 ? 'spring' : month < 8 ? 'summer' : 'autumn';
  const hour = new Date().getHours();
  let season = (read(SEASON_KEY) as Season | null) ?? realSeason;
  let night = read(NIGHT_KEY) ? read(NIGHT_KEY) === '1' : hour >= 19 || hour < 6;

  const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
  const seasonButtons = [...root.querySelectorAll<HTMLElement>('[data-season-pick]')];
  const nightButton = root.querySelector<HTMLElement>('[data-night-toggle]')!;
  const syncPressed = () => {
    seasonButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.seasonPick === season)));
    nightButton.setAttribute('aria-pressed', String(night));
  };
  syncPressed();

  // While the valley is showing, the Lo-Fi page underneath is inert (no hidden tab stops).
  const pageLayers = () => document.querySelectorAll<HTMLElement>('body > header, body > main, body > footer, body > .notice');
  const syncInert = () => {
    const showing = html.dataset.mode === 'hifi' && html.dataset.webgl !== 'false';
    pageLayers().forEach((el) => (el.inert = showing));
    root.inert = !showing;
  };

  let openZone: ZoneId | null = null;
  let onPanel: (open: HTMLElement | null) => void = () => {};
  const behindCinema = () => root.querySelectorAll<HTMLElement>('.valley-labels, .valley-bar, .valley-hint, .valley-canvas');
  const showPanel = (id: ZoneId | null, refocus = true) => {
    const previous = openZone;
    openZone = id;
    panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
    const open = panels.find((p) => !p.hidden) ?? null;
    // While the full-screen cinema is open, nothing behind it takes focus.
    behindCinema().forEach((el) => (el.inert = id === 'hollow'));
    onPanel(open);
    if (!refocus) return;
    // Focus moves into the panel, and back to the place's label when it closes.
    if (open) open.querySelector<HTMLElement>('h2')?.focus({ preventScroll: true });
    else if (previous) root.querySelector<HTMLElement>(`.valley-label[data-zone="${previous}"]`)?.focus({ preventScroll: true });
  };

  // Filter chips: workshop categories and garden topics.
  wireChips(root);

  let valley: any = null;
  let started = false;
  async function start() {
    syncInert();
    if (html.dataset.mode !== 'hifi' || html.dataset.webgl === 'false') {
      valley?.pause();
      return;
    }
    if (started) {
      valley?.resume();
      return;
    }
    started = true;
    try {
      const [{ createValley }, { VALLEY_PARTS }] = await Promise.all([import('../scenes/valley/createValley'), import('../scenes/valley/parts')]);
      const v = createValley(root.querySelector('canvas')!, root.querySelector('.valley-labels')!, {
        lang: (root.dataset.lang as 'en' | 'zh') ?? 'en',
        quality: matchMedia('(max-width: 700px)').matches ? 'low' : 'high',
        season,
        night,
        extraParts: VALLEY_PARTS,
      });
      valley = v;
      v.ready.then(() => root.classList.add('ready'));
      // Keep the focused place out from under the panel: side panel on wide screens, bottom sheet on phones.
      const phone = matchMedia('(max-width: 700px)');
      onPanel = (open) => {
        if (!open || open.dataset.panel === 'hollow') return v.setInset({ right: 0, bottom: 0 });
        const r = open.getBoundingClientRect();
        v.setInset(phone.matches ? { right: 0, bottom: Math.max(0, innerHeight - r.top) } : { right: Math.max(0, innerWidth - r.left), bottom: 0 });
      };
      addEventListener('resize', () => openZone && onPanel(panels.find((p) => !p.hidden) ?? null));
      const close = () => { v.focus(null); showPanel(null); };
      // The hollow: the camera pushes into the fire scar, the lights go down, and the cinema opens.
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let entering = 0;
      v.onSelect((id) => {
        clearTimeout(entering);
        v.focus(id);
        if (id !== 'hollow') return showPanel(id);
        showPanel(null, false);
        entering = window.setTimeout(() => {
          mountCinema(root.querySelector<HTMLElement>('.cinema-overlay [data-cinema]')!);
          showPanel('hollow');
        }, reducedMotion ? 0 : 1100);
      });
      root.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', close));
      // Esc closes the open place, unless a card inside it (a film's details) is open: that closes first.
      addEventListener('keydown', (e) => e.key === 'Escape' && openZone && html.dataset.mode === 'hifi' && !document.querySelector('dialog[open]') && close());
      seasonButtons.forEach((b) =>
        b.addEventListener('click', () => {
          season = b.dataset.seasonPick as Season;
          write(SEASON_KEY, season);
          v.setSeason(season);
          syncPressed();
        }),
      );
      nightButton.addEventListener('click', () => {
        night = !night;
        write(NIGHT_KEY, night ? '1' : '0');
        v.setNight(night);
        syncPressed();
      });
      (window as any).__valley = v;
    } catch (e) {
      // If the 3D scene cannot start, fall back to the Lo-Fi page rather than an empty screen.
      console.warn('valley unavailable, switching to Lo-Fi', e);
      html.dataset.mode = 'lofi';
      html.dataset.modeAuto = 'true';
      syncInert();
    }
  }
  start();
  addEventListener('ailula:mode', start);
</script>

<style is:global>
  .valley-root { display: none; position: fixed; inset: 0; z-index: 50; background: #cfe2e6; color: #1c241f; }
  html[data-mode='hifi'] .valley-root { display: block; }
  .valley-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; opacity: 0; transition: opacity 1.2s ease; }
  .valley-root.ready .valley-canvas { opacity: 1; }
  .valley-loading { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; font: italic 15px Georgia, 'Songti SC', serif; opacity: 0.7; transition: opacity .8s; pointer-events: none; }
  .valley-root.ready .valley-loading { opacity: 0; }
  /* z-index makes a stacking context, so the label renderer's own z-indexes never rise above panels. */
  .valley-labels { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 1; }
  .valley-label { pointer-events: auto; font: 600 11px/1 ui-monospace, 'SF Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: #fdfaf3; background: rgba(28, 34, 30, 0.62); border: 1px solid rgba(255, 255, 255, 0.25); padding: 8px 12px; border-radius: 999px; cursor: pointer; backdrop-filter: blur(6px); white-space: nowrap; }
  .ring-tag { font: 600 11px/1 ui-monospace, 'SF Mono', monospace; letter-spacing: .1em; color: #5a2a14; background: rgba(255, 236, 205, 0.92); padding: 4px 8px; border-radius: 6px; box-shadow: 0 2px 8px rgba(60, 30, 10, 0.25); opacity: 0; transform: translateX(-6px); transition: opacity .5s, transform .5s; pointer-events: none; }
  .ring-tag.on { opacity: 1; transform: none; }
  .valley-label.hover { background: rgba(28, 34, 30, 0.9); transform: scale(1.06); }
  .valley-label:hover, .valley-label:focus-visible { background: rgba(28, 34, 30, 0.88); outline: none; }
  /* A label faded by declutter comes back while it has keyboard focus. */
  .valley-label:focus-visible { opacity: 1 !important; z-index: 2; box-shadow: 0 0 0 2px #fdfaf3; }
  html[data-night='true'] .valley-root { background: #232a48; color: #eef0f7; }

  .valley-bar { z-index: 3; position: absolute; top: 0; left: 0; right: 0; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; padding: 16px clamp(12px, 3vw, 28px); pointer-events: none; }
  .valley-bar > * { pointer-events: auto; }
  /* A soft halo in the sky colour keeps the name readable over dark foliage. */
  .valley-brand { display: flex; flex-direction: column; gap: 2px; --halo: rgba(240, 230, 214, 0.9); text-shadow: 0 0 3px var(--halo), 0 0 12px var(--halo); }
  html[data-night='true'] .valley-brand { --halo: rgba(35, 42, 72, 0.9); }
  .valley-brand .name { font: 700 clamp(26px, 4vw, 40px)/1 Georgia, 'Songti SC', serif; letter-spacing: 0.04em; }
  .valley-brand .slogan { font: italic 13px/1.4 Georgia, 'Songti SC', serif; opacity: 0.8; }
  .valley-controls { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .seasons { display: flex; background: rgba(255, 253, 248, 0.72); border-radius: 999px; padding: 3px; backdrop-filter: blur(8px); }
  .seasons button { font: 600 11px ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; border: 0; background: transparent; color: #3b4038; padding: 7px 11px; border-radius: 999px; cursor: pointer; }
  html[data-season='spring'] [data-season-pick='spring'], html[data-season='summer'] [data-season-pick='summer'],
  html[data-season='autumn'] [data-season-pick='autumn'], html[data-season='winter'] [data-season-pick='winter'] { background: #2d3a30; color: #fdfaf3; }
  .valley-root .pill { font: 600 12px system-ui, sans-serif; border: 0; background: rgba(255, 253, 248, 0.72); color: #2d3a30; padding: 8px 12px; border-radius: 999px; cursor: pointer; text-decoration: none; backdrop-filter: blur(8px); }
  [data-night-toggle] .moon, html[data-night='true'] [data-night-toggle] .sun { display: none; }
  html[data-night='true'] [data-night-toggle] .moon { display: inline; }
  .valley-hint { position: absolute; left: 0; right: 0; bottom: 14px; text-align: center; margin: 0; font: 12px system-ui, sans-serif; opacity: 0.65; pointer-events: none; }

  /* Panels: frosted glass over the scene, dark glass at night. Every colour is a token so night swaps them all. */
  .vpanel { --p-bg: rgba(252, 249, 242, 0.8); --p-edge: rgba(255, 255, 255, 0.65); --p-line: rgba(110, 90, 60, 0.16); --p-ink: #1d2a20; --p-muted: #4f564c; --p-accent: #9a4f2e; --p-link: #1f3326; --p-link-hover: #a3452a; --p-card: rgba(255, 255, 255, 0.5);
    z-index: 4; position: absolute; top: 96px; right: clamp(12px, 3vw, 28px); bottom: 24px; width: min(400px, calc(100vw - 24px)); display: flex; flex-direction: column; overflow: hidden; box-sizing: border-box;
    background: var(--p-bg); color: var(--p-ink); border: 1px solid var(--p-edge); border-radius: 18px; box-shadow: 0 12px 40px rgba(20, 30, 20, 0.16);
    -webkit-backdrop-filter: blur(18px) saturate(1.2); backdrop-filter: blur(18px) saturate(1.2); animation: vpanel-in 0.45s cubic-bezier(.2,.8,.2,1); }
  html[data-night='true'] .vpanel { --p-bg: rgba(26, 30, 50, 0.78); --p-edge: rgba(255, 255, 255, 0.14); --p-line: rgba(255, 255, 255, 0.12); --p-ink: #eef0f7; --p-muted: #c3c7d6; --p-accent: #f0b58c; --p-link: #f3f1ea; --p-link-hover: #f6c49e; --p-card: rgba(255, 255, 255, 0.06); box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35); }
  .vpanel.small { bottom: auto; }
  .cinema-overlay { z-index: 6; position: fixed; inset: 0; overflow-y: auto; overflow-x: hidden; background: #15120f; color: #f1ebe0; padding: 0 max(16px, calc(50vw - 560px)) 48px; box-sizing: border-box; animation: lights-down 0.9s ease-out; }
  .cinema-overlay[hidden] { display: none; }
  html[data-motion='reduced'] .cinema-overlay { animation: none; }
  @keyframes lights-down { 0% { opacity: 0; } 35% { opacity: 0.55; } 45% { opacity: 0.25; } 60% { opacity: 0.8; } 100% { opacity: 1; } }
  .cin-bar { position: sticky; top: 0; z-index: 2; display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 18px 0 10px; background: linear-gradient(#15120f 80%, transparent); }
  .cin-bar h2 { font: 700 22px/1.3 Georgia, 'Songti SC', serif; margin: 0; outline: none; }
  .cin-bar .cin-intro { margin: 4px 0 0; color: #b6ab9b; font-size: 14px; }
  .cin-bar .vclose { flex: none; width: 36px; height: 36px; display: grid; place-items: center; border-radius: 999px; border: 1px solid rgba(255, 240, 220, 0.2); background: rgba(255, 240, 220, 0.06); color: #f1ebe0; cursor: pointer; }
  .vpanel.wide { width: min(680px, calc(100vw - 24px)); }
  .vpanel { --p-on-ink: #fdfaf3; }
  html[data-night='true'] .vpanel { --p-on-ink: #1a1e32; }
  .vpanel .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0 14px; }
  .vpanel .chips button { font: 600 12px system-ui, sans-serif; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--p-line); background: var(--p-card); color: var(--p-ink); cursor: pointer; }
  .vpanel .chips button[aria-pressed='true'] { background: var(--p-ink); border-color: var(--p-ink); color: var(--p-on-ink); }
  .vpanel .chips button:focus-visible { outline: 2px solid var(--p-ink); outline-offset: 2px; }
  .vpanel .pstack { display: grid; gap: 10px; }
  .vpanel[hidden] { display: none; }
  @keyframes vpanel-in { from { opacity: 0; transform: translateY(12px); } }
  /* Title and close stay put; only the body scrolls, fading out at the bottom edge. */
  .vhead { display: flex; align-items: flex-start; gap: 12px; padding: 18px 14px 8px 22px; }
  .vpanel h2 { flex: 1; font: 700 20px/1.3 Georgia, 'Songti SC', serif; margin: 6px 0 0; outline: none; }
