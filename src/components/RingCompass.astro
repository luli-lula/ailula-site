---
// Tree-ring compass: one irregular ring per year; the page script marks reached/current rings.
import { ringPath, ringRadii } from '../lib/rings';

const scale = 0.62;
const rings = ringRadii(scale);
const outer = rings.at(-1)!.radius;
const fills = rings.map((_, i) => {
  const t = i / (rings.length - 1);
  return `hsl(${24 + t * 6}, ${48 - t * 10}%, ${48 + t * 22}%)`;
});
---
<button class="ring-compass" type="button" aria-label="Tree-ring timeline">
  <svg viewBox={`${-outer - 10} ${-outer - 10} ${(outer + 10) * 2} ${(outer + 10) * 2}`} width="120" height="120">
    <path d={ringPath(outer + 6, 1.6, 1, 3)} fill="#5a2a17" />
    {rings.slice().reverse().map((r, k) => {
      const i = rings.length - 1 - k;
      return <path class="ring" data-ring={r.year} d={ringPath(r.radius, 1.0, i * 0.7, 11 + i)} fill={fills[i]} stroke="#7a3d20" stroke-opacity="0.55" stroke-width="0.6" />;
    })}
    {rings.map((r, i) => <path class="ring-mark" data-mark={r.year} d={ringPath(r.radius, 1.0, i * 0.7, 11 + i)} fill="none" />)}
    <path d={`M1 -1 L${outer * 0.35} ${-outer * 0.5} L${outer * 0.42} ${-outer * 0.78}`} stroke="#4a2212" stroke-opacity="0.5" fill="none" stroke-width="0.8" />
  </svg>
  <span class="ring-label" data-testid="ring-label">2017</span>
</button>

<style>
  .ring-compass { position: fixed; right: 20px; bottom: 20px; z-index: 5; background: rgba(255, 253, 248, 0.88); border: 0; border-radius: 50%; width: 136px; height: 136px; display: grid; place-items: center; cursor: pointer; box-shadow: 0 6px 24px rgba(20, 30, 20, 0.25); padding: 0; }
  @media (max-width: 700px) { .ring-compass { width: 92px; height: 92px; right: 12px; bottom: 12px; } .ring-compass svg { width: 80px; height: 80px; } }
  .ring { transition: fill-opacity 0.4s; fill-opacity: 0.3; }
  .ring.reached { fill-opacity: 1; }
  .ring-mark { stroke: transparent; stroke-width: 2; transition: stroke 0.3s; pointer-events: stroke; }
  .ring-mark.current { stroke: #b5482c; }
  .ring-label { position: absolute; bottom: -22px; font: 600 11px ui-monospace, monospace; color: #f5efe6; text-shadow: 0 1px 3px rgba(0,0,0,.6); }
</style>
