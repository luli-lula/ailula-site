---
import Article from '../../views/Article.astro';
import { localized } from '../../lib/content';

export async function getStaticPaths() {
  const items = await localized('projects', 'en');
  return items.map(({ slug, entry, fallback }) => ({ params: { slug }, props: { entry, fallback } }));
}
const { entry, fallback } = Astro.props;
---
<Article lang="en" entry={entry} fallback={fallback} />
