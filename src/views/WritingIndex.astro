---
import Base from '../layouts/Base.astro';
import LangBadge from '../components/LangBadge.astro';
import { localizedPath, t, type Lang } from '../lib/i18n';
import { byDateDesc, localized } from '../lib/content';
import { TOPICS, topicLabel } from '../lib/topics';

interface Props { lang: Lang }
const { lang } = Astro.props;
const posts = (await localized('posts', lang)).sort(byDateDesc);
// Posts written or translated in this language come first; on the English site the rest are listed under
// "More in Chinese" with their English titles, linking straight to the Chinese page.
const own = posts.filter((p) => !p.fallback);
const more = posts.filter((p) => p.fallback);
const topics = TOPICS.filter((tp) => posts.some((p) => p.entry.data.topics.includes(tp)));
const date = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title={t(lang, 'navWriting')}>
  <h1>{t(lang, 'navWriting')}</h1>
  <div data-filter-scope>
    <div class="chips" role="group" aria-label={t(lang, 'navWriting')} data-filter>
      <button type="button" data-key="all" aria-pressed="true">{t(lang, 'cat_all')}</button>
      {topics.map((tp) => <button type="button" data-key={tp} aria-pressed="false">{topicLabel(tp, lang)}</button>)}
    </div>
    {own.length > 0 && (
      <section data-group>
        <ul class="list">
          {own.map(({ slug, entry }) => (
            <li data-keys={entry.data.topics.join(' ')}><time>{date(entry.data.date)}</time><a href={localizedPath(`/writing/${slug}/`, lang)}>{entry.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}
    {more.length > 0 && (
      <section id="more-in-chinese" data-group>
        <h2>{t(lang, 'moreInChinese')}</h2>
        <p class="note">{t(lang, 'moreInChineseNote')}</p>
        <ul class="list">
          {more.map(({ slug, entry }) => (
            <li data-keys={entry.data.topics.join(' ')}><time>{date(entry.data.date)}</time><a href={localizedPath(`/writing/${slug}/`, entry.data.lang as Lang)} hreflang={entry.data.lang}>{entry.data.titleEn ?? entry.data.title}</a><LangBadge lang={lang} /></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<script>
  import { wireChips } from '../scripts/chips';
  wireChips(document);
</script>

<style>
  .note { color: var(--muted); font-size: 14px; margin: -6px 0 8px; }
  h2 { margin-top: 36px; }
</style>
