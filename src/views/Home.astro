---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import Valley from '../components/Valley.astro';
import Contact from '../components/Contact.astro';
import Chapters from '../components/Chapters.astro';
import LangBadge from '../components/LangBadge.astro';
import { community } from '../data/community';
import { profile } from '../data/profile';
import { localizedPath, t, type Lang } from '../lib/i18n';
import { byDateDesc, localized, projectGroups } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const groups = await projectGroups(lang);
const posts = (await localized('posts', lang)).sort(byDateDesc).slice(0, 5);
const fmt = (d?: Date) => (d ? d.toISOString().slice(0, 10) : '');
---
<Base>
  <section class="hero">
    <h1>lula</h1>
    <p class="slogan">{t(lang, 'slogan')}</p>
    <p>{t(lang, 'intro')}</p>
  </section>

  {profile.now[lang] ? (
    <section>
      <h2>{t(lang, 'sectionNow')}</h2>
      <p>{profile.now[lang]}</p>
      <p><a href={localizedPath('/projects/', lang)}>{t(lang, 'seeProjects')} →</a> · <a href={localizedPath('/map/', lang)}>{t(lang, 'footprints')} →</a></p>
    </section>
  ) : <Placeholder note={lang === 'zh' ? '此刻卡片：正在做什么、在找什么' : '"Right now": what I am doing and looking for'} />}

  <section>
    <h2>{t(lang, 'sectionTimeline')}</h2>
    <Chapters lang={lang} />
  </section>

  <section>
    <h2>{t(lang, 'communityTitle')}</h2>
    <ul class="plain">{community[lang].map((c) => <li>{c}</li>)}</ul>
  </section>

  <section>
    <h2>{t(lang, 'sectionProjects')}</h2>
    {groups.map(({ category, items }) => (
      <>
        <h3>{t(lang, `cat_${category}`)}</h3>
        <ul class="list">
          {items.map(({ slug, entry, fallback }) => (
            <li>
              <a href={localizedPath(`/projects/${slug}/`, lang)}>{entry.data.title}</a>
              <span class="muted">{entry.data.summary}</span>
              {fallback && <LangBadge lang={lang} />}
            </li>
          ))}
        </ul>
      </>
    ))}
  </section>

  <section>
    <h2>{t(lang, 'sectionWriting')}</h2>
    <ul class="list">
      {posts.map(({ slug, entry, fallback }) => (
        <li><time>{fmt(entry.data.date)}</time>{fallback
          ? <><a href={localizedPath(`/writing/${slug}/`, entry.data.lang as Lang)} hreflang={entry.data.lang}>{entry.data.titleEn ?? entry.data.title}</a><LangBadge lang={lang} /></>
          : <a href={localizedPath(`/writing/${slug}/`, lang)}>{entry.data.title}</a>}</li>
      ))}
    </ul>
    <p><a href={localizedPath('/writing/', lang)}>{t(lang, 'allPosts')} →</a></p>
  </section>

  <section>
    <h2>{t(lang, 'sectionContact')}</h2>
    <Contact lang={lang} />
  </section>

  <!-- Hi-Fi home: rendered last so the Lo-Fi content above stays first in the document. -->
  <Valley slot="overlay" lang={lang} />
</Base>

<style>
  .hero { padding: 24px 0 8px; }
  .hero h1 { font-size: clamp(44px, 10vw, 72px); margin: 0; }
  .slogan { font-size: 20px; margin: 4px 0 12px; color: var(--accent); }
  .muted { color: var(--muted); font-size: 14px; }
  .plain { padding-left: 1.2em; line-height: 1.7; }
</style>
