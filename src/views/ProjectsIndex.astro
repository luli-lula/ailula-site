---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { t, type Lang } from '../lib/i18n';
import { projectGroups } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const groups = await projectGroups(lang);
---
<Base title={t(lang, 'navProjects')}>
  <h1>{t(lang, 'navProjects')}</h1>
  {groups.map(({ category, items }) => (
    <section>
      <h2>{t(lang, `cat_${category}`)}</h2>
      <div class="pgrid">
        {items.map(({ slug, entry, fallback }) => <ProjectCard lang={lang} slug={slug} entry={entry} fallback={fallback} size={entry.data.featured ? 'large' : 'normal'} />)}
      </div>
    </section>
  ))}
</Base>

<style>
  section h2 { margin-top: 32px; }
</style>
