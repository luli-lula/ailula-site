---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base title={t(lang, 'navCinema')}>
  <h1>{t(lang, 'navCinema')}</h1>
  <h2>{t(lang, 'sectionTopTen')}</h2>
  <ol>
    {Array.from({ length: 10 }, (_, i) => <li><Placeholder note={lang === 'zh' ? `十佳第 ${i + 1} 部` : `top-10 film #${i + 1}`} /></li>)}
  </ol>
  <p>{t(lang, 'cinemaComing')}</p>
</Base>
